# ---------------------------------------------------------
# FASTAPI APP & ENDPOINTS
# ---------------------------------------------------------
app = FastAPI(title="Gaming Adda")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

def get_db():
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()

# PYDANTIC SCHEMAS
class BookingRequest(BaseModel):
    station_id: str
    game_title: str
    customer_name: str
    customer_phone: str
    duration_minutes: int

class StockToggleRequest(BaseModel):
    item_id: str
    in_stock: bool
    pin: str

class AddGameRequest(BaseModel):
    title: str
    platform: str
    genre: str
    badge: Optional[str] = "NEW"
    pin: str

# ROUTES
@app.get("/api/stations")
def get_stations(branch_id: str = "shop_a", db: Session = Depends(get_db)):
    return db.query(StationModel).filter(StationModel.branch_id == branch_id).all()

@app.get("/api/games")
def get_games(platform: Optional[str] = None, db: Session = Depends(get_db)):
    query = db.query(GameModel)
    if platform:
        query = query.filter(GameModel.platform == platform.upper())
    return query.all()

@app.post("/api/games")
def add_new_game(req: AddGameRequest, db: Session = Depends(get_db)):
    if req.pin != "9900":
        raise HTTPException(status_code=403, detail="Invalid admin PIN")
    
    new_game = GameModel(
        id=f"{req.platform.lower()}-{int(datetime.utcnow().timestamp())}",
        title=req.title.strip(),
        platform=req.platform.upper(),
        genre=req.genre.strip(),
        badge=req.badge or "NEW"
    )
    db.add(new_game)
    db.commit()
    db.refresh(new_game)
    return new_game

@app.get("/api/menu")
def get_menu(branch_id: str = "shop_a", db: Session = Depends(get_db)):
    return db.query(MenuItemModel).filter(MenuItemModel.branch_id == branch_id).all()

@app.post("/api/menu/stock-toggle")
def toggle_stock(req: StockToggleRequest, db: Session = Depends(get_db)):
    if req.pin != "9900":
        raise HTTPException(status_code=403, detail="Invalid admin PIN")
    
    item = db.query(MenuItemModel).filter(MenuItemModel.id == req.item_id).first()
    if not item:
        raise HTTPException(status_code=404, detail="Item not found")
    
    item.in_stock = req.in_stock
    db.commit()
    return {"message": "Stock status updated", "item_id": item.id, "in_stock": item.in_stock}

@app.post("/api/bookings")
def create_booking(req: BookingRequest, db: Session = Depends(get_db)):
    station = db.query(StationModel).filter(StationModel.id == req.station_id).first()
    if not station:
        raise HTTPException(status_code=404, detail="Station not found")
    if station.status != "available":
        raise HTTPException(status_code=400, detail="Station is already occupied")

    hours = req.duration_minutes / 60.0
    total_bill = station.price_per_hour * hours

    booking = SessionBookingModel(
        id=f"BK-{int(datetime.utcnow().timestamp())}",
        branch_id=station.branch_id,
        station_id=station.id,
        game_title=req.game_title,
        customer_name=req.customer_name,
        customer_phone=req.customer_phone,
        duration_minutes=req.duration_minutes,
        total_amount=total_bill,
        status="active"
    )
    station.status = "occupied"
    station.active_game = req.game_title

    db.add(booking)
    db.commit()
    db.refresh(booking)
    return {"message": "Booking successful", "booking": booking}

