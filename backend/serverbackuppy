class CreateOrderRequest(BaseModel):
    branch_id: str
    station_id: str
    items_summary: str
    total_amount: float

class ReleaseStationRequest(BaseModel):
    station_id: str
    pin: str

@app.get("/api/orders")
def get_orders(branch_id: str = "shop_a", db: Session = Depends(get_db)):
    """Counter staff view: retrieve all pending food & drink orders for a branch"""
    return db.query(OrderModel).filter(OrderModel.branch_id == branch_id).order_by(OrderModel.created_at.desc()).all()

@app.post("/api/orders")
def create_order(req: CreateOrderRequest, db: Session = Depends(get_db)):
    """Customer in-seat order: delivers directly to their gaming station"""
    new_order = OrderModel(
        id=f"ORD-{int(datetime.utcnow().timestamp())}",
        branch_id=req.branch_id,
        station_id=req.station_id,
        items_summary=req.items_summary,
        total_amount=req.total_amount,
        status="pending"
    )
    db.add(new_order)
    db.commit()
    db.refresh(new_order)
    return {"message": "Order sent to kitchen", "order": new_order}

@app.post("/api/stations/release")
def release_station(req: ReleaseStationRequest, db: Session = Depends(get_db)):
    """Staff action: end session and free up seat"""
    if req.pin != "9900":
        raise HTTPException(status_code=403, detail="Invalid admin PIN")
    st = db.query(StationModel).filter(StationModel.id == req.station_id).first()
    if not st:
        raise HTTPException(status_code=404, detail="Station not found")
    st.status = "available"
    st.active_game = None
    db.commit()
    return {"message": "Station is now available", "station_id": st.id}